{
  "name": "dobson-push-to-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.cjs",
    "build": "npm run prepare:web && vite build",
    "test": "node --test",
    "cap:sync": "npm run build && cap sync && node scripts/configure-native.cjs",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@dobson/capacitor-dobson": "file:plugins/capacitor-dobson"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "vite": "^8.3.6"
  }
}
